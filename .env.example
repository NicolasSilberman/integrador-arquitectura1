# Copiá este archivo como .env (el .env NO se sube al repo) y completá los valores.
# docker compose lo lee automáticamente.

# Base de datos
DB_NAME=expensas
DB_USER=expensas
DB_PASSWORD=cambiar-esta-clave

# Contraseña del usuario propio de la API en la base (api_expensas), distinta de la anterior
API_DB_PASSWORD=cambiar-esta-clave-de-la-api

# Contraseña del administrador de la consola de Keycloak (usuario "admin")
KEYCLOAK_ADMIN_PASSWORD=cambiar-esta-clave-tambien

# API key con la que la API se autentica ante el banco (ADR-010). En la demo la usan la API y el banco simulado
BANCO_API_KEY=cambiar-esta-clave-del-banco
