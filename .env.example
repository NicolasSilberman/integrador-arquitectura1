# Copiá este archivo a ".env" (que NO se sube al repositorio) y cambiá los valores.
# Si no existe .env, docker compose usa los valores por defecto de desarrollo del docker-compose.yml.

# Contraseña de la base de datos (usuario "expensas")
DB_PASSWORD=cambiar-esta-clave

# Contraseña del administrador de la consola de Keycloak (usuario "admin")
KEYCLOAK_ADMIN_PASSWORD=cambiar-esta-clave-tambien

# URL con la que el NAVEGADOR llega a Keycloak. Tiene que coincidir con el "iss" de los tokens.
# En un servidor real: https://identidad.tu-dominio.com
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Conciliación automática diaria con el banco
CONCILIACION_AUTOMATICA=true
CONCILIACION_HORA=07:00
